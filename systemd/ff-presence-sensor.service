[Unit]
Description=FF Power Manager - Lenovo ToF human-presence sensor
After=systemd-udev-settle.service

[Service]
Type=simple
Environment=PYTHONPATH=/usr/local/lib/ff-power-manager
ExecStart=/usr/bin/python3 -m fpm.sensor
ExecStopPost=-/usr/bin/env PYTHONPATH=/usr/local/lib/ff-power-manager /usr/bin/python3 -m fpm.sensor --disable
Restart=on-failure
RestartSec=2
Nice=10

[Install]
WantedBy=multi-user.target
